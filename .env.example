VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Django reads the Supabase VITE_ values above automatically.
# Set these only if the backend needs separate environment variable names.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false; generate a private random value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Private PostgreSQL connection for running SQL migrations only.
# Copy from Supabase Connect; replace its password placeholder locally.
# Use the session pooler if the direct host is not reachable on your network.
DATABASE_URL=

# Keep disabled on the existing hosted prototype. Enable only after the new
# schema and its exact target/execution have been independently approved.
NECMS_ENABLED=false
VITE_NECMS_ENABLED=false

# --- CRAN Tech Challenge demo (npm run demo:cran). Synthetic data only. ---
# Put these in .env.cran (git-ignored). Without a key the demo uses the rule-based engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force the rule-based engine even with a key (stage fallback test).
AI_DISABLED=false
# Demo store: file (default, local JSON) | supabase (separate synthetic-only project; see supabase/cran-demo/)
CRAN_STORE=file
CRAN_SUPABASE_URL=
CRAN_SUPABASE_KEY=
# Browser realtime for the supabase store
VITE_CRAN_REALTIME=
VITE_CRAN_SUPABASE_URL=
VITE_CRAN_SUPABASE_KEY=
# National registry connector: mock (default) | fhir-http (real FHIR R4 registry)
REGISTRY_CONNECTOR=mock
REGISTRY_BASE_URL=
REGISTRY_TOKEN=
# Must stay false for the pilot (start.ps1 refuses to start otherwise)
CRAN_DEMO=false
VITE_CRAN_DEMO=false
