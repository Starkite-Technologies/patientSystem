# Copy to /opt/patientflow/.env on the server (chmod 600, owner patientflow).
# Never commit the filled-in copy.

# Public values: baked into the frontend at build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Django (server only).
DJANGO_DEBUG=false
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=pilot.example.com
# Caddy terminates TLS and redirects HTTP; Django only listens on loopback.
DJANGO_SECURE_SSL_REDIRECT=false

# Pilot runs the single-department board. Keep NECMS off.
NECMS_ENABLED=false
VITE_NECMS_ENABLED=false

# Do NOT set DATABASE_URL on the server. It is only for migrations,
# which are applied manually from the Supabase SQL Editor for this pilot.
