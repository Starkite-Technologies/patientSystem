[Unit]
Description=PatientFlow Django API (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=patientflow
Group=patientflow
WorkingDirectory=/opt/patientflow/backend
ExecStart=/opt/patientflow/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 30 --access-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/patientflow

[Install]
WantedBy=multi-user.target
